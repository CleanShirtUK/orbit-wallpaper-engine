// Allow the desktop user to update only Noctalia's greeter appearance.
polkit.addRule(function(action, subject) {
    if (subject.user == "josh" &&
        action.id == "org.noctalia.greeter.apply-appearance") {
        return polkit.Result.YES;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");

    if (subject.user == "josh" &&
        action.id == "org.freedesktop.systemd1.manage-units" &&
        (unit == "noctalia-greeter-apply-appearance" ||
         unit == "noctalia-greeter-apply-appearance.service") &&
        verb == "start") {
        return polkit.Result.YES;
    }
});
