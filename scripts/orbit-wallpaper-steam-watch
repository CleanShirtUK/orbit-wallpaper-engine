#!/usr/bin/env python3
"""Hide Orbit Wallpaper Engine while Steam games are open on Hyprland.

Tracks Hyprland windows whose class/initialClass matches steam_app_<appid>.
When the first game appears, sends `exit`; when the last game disappears,
sends `intro`.
"""

from __future__ import annotations

import glob
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

STEAM_CLASS = re.compile(r"^steam_app_\d+$", re.IGNORECASE)
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
CONTROL = Path(os.environ.get(
    "ORBIT_WALLPAPER_CONTROL_FILE",
    CACHE / "orbit-wallpaper-engine" / "control",
))


def log(message: str) -> None:
    print(f"orbit-wallpaper-steam-watch: {message}", file=sys.stderr, flush=True)


def find_instance() -> tuple[str, Path] | None:
    preferred = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "").strip()
    if preferred:
        path = RUNTIME / "hypr" / preferred / ".socket2.sock"
        if path.exists():
            return preferred, path

    candidates = []
    for value in glob.glob(str(RUNTIME / "hypr" / "*" / ".socket2.sock")):
        path = Path(value)
        try:
            candidates.append((path.stat().st_mtime, path.parent.name, path))
        except OSError:
            pass

    if not candidates:
        return None

    _, signature, path = max(candidates)
    return signature, path


def send_control(command: str) -> None:
    try:
        with CONTROL.open("w", encoding="utf-8") as handle:
            handle.write(command + "\n")
        log(f"sent {command}")
    except OSError as error:
        log(f"could not send {command}: {error}")


def initial_games(signature: str) -> set[str]:
    env = os.environ.copy()
    env["HYPRLAND_INSTANCE_SIGNATURE"] = signature
    try:
        proc = subprocess.run(
            ["hyprctl", "-j", "clients"],
            env=env,
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
        if proc.returncode != 0:
            return set()
        clients = json.loads(proc.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return set()

    games: set[str] = set()
    for client in clients:
        window_class = str(client.get("class") or "")
        initial_class = str(client.get("initialClass") or "")
        if STEAM_CLASS.match(window_class) or STEAM_CLASS.match(initial_class):
            address = str(client.get("address") or "").removeprefix("0x")
            if address:
                games.add(address.lower())
    return games


def watch(signature: str, event_socket: Path) -> None:
    games = initial_games(signature)
    if games:
        send_control("exit")

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(event_socket))
    reader = sock.makefile("r", encoding="utf-8", errors="replace")

    log(f"watching Hyprland instance {signature}")

    for raw in reader:
        line = raw.rstrip("\n")
        event, separator, data = line.partition(">>")
        if not separator:
            continue

        if event == "openwindow":
            parts = data.split(",", 3)
            if len(parts) < 3:
                continue
            address = parts[0].lower().removeprefix("0x")
            window_class = parts[2]
            if STEAM_CLASS.match(window_class):
                was_empty = not games
                games.add(address)
                log(f"Steam game opened: {window_class} ({address})")
                if was_empty:
                    send_control("exit")

        elif event == "closewindow":
            address = data.lower().removeprefix("0x")
            if address in games:
                games.remove(address)
                log(f"Steam game closed: {address}")
                if not games:
                    send_control("intro")


def main() -> None:
    while True:
        found = find_instance()
        if not found:
            time.sleep(2)
            continue

        signature, event_socket = found
        try:
            watch(signature, event_socket)
        except (OSError, BrokenPipeError) as error:
            log(f"Hyprland event connection lost: {error}")
            time.sleep(1)


if __name__ == "__main__":
    main()
